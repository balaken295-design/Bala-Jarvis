<Page x:Class="BalaJarvisWindowsBridge.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#07121B">
  <Grid Padding="28">
    <StackPanel Spacing="14" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="BALA JARVIS // WINDOWS BRIDGE" FontSize="26" Foreground="#45DFFF" />
      <TextBlock Text="Phone Link · WhatsApp Desktop · Microsoft Teams" FontSize="15" Foreground="#D9F6FF" />
      <TextBlock Text="This companion reads Windows notifications only after you grant permission. It forwards recognised incoming-call alerts to the Jarvis server on this PC." TextWrapping="Wrap" Foreground="#9BBAC8" />
      <Button x:Name="GrantButton" Content="GRANT NOTIFICATION ACCESS" Click="GrantButton_Click" HorizontalAlignment="Stretch" />
      <TextBlock x:Name="StatusText" Text="Status: permission not checked." TextWrapping="Wrap" Foreground="#45DFFF" />
      <TextBlock Text="Keep this app open while monitoring. It does not answer, reject, or record calls." TextWrapping="Wrap" Foreground="#9BBAC8" />
    </StackPanel>
  </Grid>
</Page>
