<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap">
  <Identity Name="BalaJarvisWindowsBridge" Publisher="CN=BalaJarvis" Version="1.0.0.0" />
  <Properties>
    <DisplayName>BALA JARVIS Windows Bridge</DisplayName>
    <PublisherDisplayName>BALA JARVIS</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources><Resource Language="en-us" /></Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="BalaJarvisWindowsBridge.App">
      <uap:VisualElements DisplayName="BALA JARVIS Windows Bridge" Description="Local notification bridge for BALA JARVIS" BackgroundColor="#07121B" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities><uap:Capability Name="userNotificationListener" /></Capabilities>
</Package>
